{
  "manifest_version": 4,
  "name": "爆单MJ共享",
  "version": "1.3.0",
  "description": "Fetch a token via credentials or use an existing one to jump straight into Discord DM view.",
  "update_url": "https://pcn5w6ahv4gg.feishu.cn/wiki/DN9MwqachiP1Vpkpj9rcbTIKnHb",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "webRequest",
    "downloads",
    "cookies",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://xxx/*",
    "https://discord.com/*",
    "*://*.midjourney.com/*",
    "https://cdn.midjourney.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.midjourney.com/*"
      ],
      "css": [
        "stylee.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.midjourney.com/*"
      ],
      "js": [
        "authSession.js",
        "downloadHelpers.js",
        "contentmj.js"
      ],
      "run_at": "document_end"
    }
  ]
}